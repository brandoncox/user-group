# shellcheck shell=bash
# Demo 4 - OpenShift storage
: "${NS:=demo-storage}"
: "${NS_DISPLAY:=Storage}"
: "${NS_DESCRIPTION:=OpenShift Storage Demo}"
: "${ADMIN_USER:=admin}"   # sets up the demo; drives the ODF and OADP parts (RHDP: admin)
: "${EDIT_USER:=user1}"    # developer - edit role + monitoring-rules-edit
: "${VIEW_USER:=user2}"    # read-only - view role
: "${RESTORE_NS:=demo-storage-restore}"   # Part 9 restores the backup here
# Part 2: static NFS volumes - an export on an existing lab NFS server with
# subdirectories pv1..pv10 (see DEMO-SCRIPT.md, "The NFS export")
# The routed 1 Gbps interface (192.168.11.45), reachable from the nodes and
# from the presenter's laptop. Later: the 10 Gbps storage VLAN,
# cloud.storage.peterlarsen.org (192.168.20.45) - only the nodes can reach it
# (192.168.20.81-86); see DEMO-SCRIPT.md, "The NFS export".
# Branch rhdp-external-odf: no lab file server, so the default is
# "in-cluster" - the NFS server pod of nfs-server.yml (the address is its
# Service's cluster IP, the PVs mount <ip>:/pvN; NFS_EXPORT is ignored).
# Lab: NFS_SERVER=cloud.peterlarsen.org (NFS_EXPORT stays /mnt/fileserver).
: "${NFS_SERVER:=in-cluster}"
: "${NFS_EXPORT:=/mnt/fileserver}"
: "${NFS_SERVER_NS:=demo-storage-nfs-server}"   # project of the in-cluster server